{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca Input Viewer",
  "version": "0.1.0",
  "identifier": "com.orca.inputviewer",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../ui"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/theorcadotgg/orca-obs-viewer/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_ME_TAURI_UPDATER_PUBLIC_KEY"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orca Input Viewer",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "Orca Overlay",
        "width": 600,
        "height": 370,
        "minWidth": 400,
        "minHeight": 270,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "url": "overlay.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  }
}
